rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Функции для проверки авторизации
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return request.auth.uid == userId;
    }
    
    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function getEventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }
    
    function getCommunityData(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data;
    }
    
    // Проверка возраста по дате рождения
    function isOldEnough(minAge) {
      let userAge = getUserData(request.auth.uid).age;
      return userAge >= minAge;
    }
    
    // Проверка приватности профиля
    function canViewUserProfile(targetUserId) {
      let targetUser = getUserData(targetUserId);
      let privacyLevel = targetUser.privacyLevel;
      
      // privacyLevel: 0 = public, 1 = friends, 2 = private, 3 = hidden
      return privacyLevel == 0 || 
             isUser(targetUserId) ||
             (privacyLevel == 1 && isFriend(targetUserId)) ||
             (privacyLevel == 2 && isUser(targetUserId));
    }
    
    function isFriend(userId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId));
    }
    
    // Коллекция users
    match /users/{userId} {
      // Чтение профиля с учетом приватности
      allow read: if canViewUserProfile(userId);
      
      // Пользователь может редактировать только свой профиль
      allow create: if isAuthenticated() && isUser(userId);
      allow update: if isUser(userId);
      allow delete: if isUser(userId);
      
      // Подколлекция friends (друзья)
      match /friends/{friendId} {
        allow read: if isUser(userId);
        allow write: if isUser(userId);
      }
      
      // Подколлекция sentRequests (отправленные запросы дружбы)
      match /sentRequests/{targetId} {
        allow read: if isUser(userId);
        allow write: if isUser(userId);
      }
      
      // Подколлекция receivedRequests (полученные запросы дружбы)
      match /receivedRequests/{senderId} {
        allow read: if isUser(userId);
        allow write: if isUser(userId);
      }
    }
    
    // Коллекция events
    match /events/{eventId} {
      let eventData = getEventData(eventId);
      
      // Чтение событий с учетом видимости и возраста
      allow read: if isAuthenticated() && (
        eventData.visibility == 'public' ||
        eventData.organizerId == request.auth.uid ||
        request.auth.uid in eventData.participants
      ) && (
        !('minAge' in eventData) ||
        isOldEnough(eventData.minAge)
      );
      
      // Создание события (проверка возраста 25+)
      allow create: if isAuthenticated() && 
                       isUser(eventData.organizerId) &&
                       isOldEnough(25);
      
      // Редактирование события (только организатор)
      allow update: if isUser(eventData.organizerId);
      
      // Удаление события (только организатор)
      allow delete: if isUser(eventData.organizerId);
      
      // Подколлекция participants (участники)
      match /participants/{participantId} {
        allow read: if isAuthenticated() &&
                       (eventData.organizerId == request.auth.uid ||
                        request.auth.uid in eventData.participants);
        allow write: if isAuthenticated() && isUser(participantId);
      }
      
      // Подколлекция reviews (отзывы)
      match /reviews/{reviewId} {
        let reviewData = resource.data;
        
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                         isUser(reviewData.reviewerId) &&
                         request.auth.uid in eventData.participants;
        allow update, delete: if isUser(reviewData.reviewerId);
      }
    }
    
    // Коллекция communities
    match /communities/{communityId} {
      let communityData = getCommunityData(communityId);
      
      // Чтение сообществ с учетом приватности
      allow read: if isAuthenticated() && (
        communityData.privacyLevel == 'public' ||
        communityData.creatorId == request.auth.uid ||
        request.auth.uid in communityData.members ||
        request.auth.uid in communityData.moderators
      );
      
      // Создание сообщества (проверка возраста 25+)
      allow create: if isAuthenticated() && 
                       isUser(communityData.creatorId) &&
                       isOldEnough(25);
      
      // Редактирование (только создатель)
      allow update: if isUser(communityData.creatorId);
      
      // Удаление (только создатель)
      allow delete: if isUser(communityData.creatorId);
      
      // Подколлекция members (члены сообщества)
      match /members/{memberId} {
        allow read: if isAuthenticated() &&
                       (communityData.privacyLevel == 'public' ||
                        request.auth.uid in communityData.members);
        allow write: if isAuthenticated() && isUser(memberId);
      }
      
      // Подколлекция moderators (модераторы)
      match /moderators/{modId} {
        allow read: if isAuthenticated();
        allow write: if isUser(communityData.creatorId);
      }
      
      // Подколлекция pendingRequests (запросы на вступление)
      match /pendingRequests/{requestId} {
        allow read: if isAuthenticated() &&
                       (isUser(communityData.creatorId) ||
                        request.auth.uid in communityData.moderators);
        allow write: if isAuthenticated();
      }
    }
    
    // Коллекция interests
    match /interests/{interestId} {
      allow read: if isAuthenticated();
      allow write: if false; // Только админ может создавать интересы
    }
    
    // Коллекция messages (сообщения в чатах)
    match /messages/{messageId} {
      let messageData = resource.data;
      
      allow read: if isAuthenticated() &&
                     (messageData.senderId == request.auth.uid ||
                      messageData.recipientId == request.auth.uid);
      
      allow create: if isAuthenticated() && 
                       isUser(messageData.senderId) &&
                       messageData.recipientId != null;
      
      allow update: if isUser(messageData.senderId);
      allow delete: if isUser(messageData.senderId);
    }
    
    // Коллекция notifications (уведомления)
    match /notifications/{notificationId} {
      let notificationData = resource.data;
      
      allow read: if isAuthenticated() && 
                     isUser(notificationData.userId);
      
      allow write: if isAuthenticated() && 
                      isUser(notificationData.userId);
    }
    
    // Коллекция reports (жалобы)
    match /reports/{reportId} {
      let reportData = resource.data;
      
      // Создание жалобы
      allow create: if isAuthenticated() && 
                       isUser(reportData.reporterId);
      
      // Чтение жалоб (только автор и админ)
      allow read: if isAuthenticated() && 
                     (isUser(reportData.reporterId) ||
                      isAdmin());
      
      // Обновление (модерация)
      allow update: if isAdmin();
      
      allow delete: if false;
    }
    
    // Функция для проверки администратора
    function isAdmin() {
      return getUserData(request.auth.uid).isAdmin == true;
    }
    
    // Коллекция activityHistory (история активности)
    match /activityHistory/{userId}/events/{eventId} {
      allow read: if isAuthenticated() && 
                     (isUser(userId) || isAdmin());
      
      allow write: if isUser(userId);
    }
    
    // Коллекция userSettings (настройки пользователя)
    match /userSettings/{userId} {
      allow read: if isUser(userId);
      
      allow write: if isUser(userId);
    }
  }
}
