rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth.uid != null;
    }

    function isEventOrganizer(eventId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    function isEventParticipant(eventId) {
      return isSignedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/events/$(eventId)).data.participants;
    }

    function isCommunityModeratorOrCreator(communityId) {
      return isSignedIn() &&
        (
          firestore.get(/databases/(default)/documents/communities/$(communityId)).data.creatorId == request.auth.uid ||
          request.auth.uid in firestore.get(/databases/(default)/documents/communities/$(communityId)).data.moderators
        );
    }

    // Профилей пользователей
    match /users/{userId}/avatar {
      // Пользователь может загружать только свой аватар
      allow write: if isSignedIn() && request.auth.uid == userId;
      // Может читать аватары других пользователей с проверкой приватности
      allow read: if true;
    }

    // Обложки событий
    match /events/{eventId}/cover {
      // Загрузка только организатором события
      allow write: if isEventOrganizer(eventId);
      allow read: if true;
    }

    // Фото в событиях
    match /events/{eventId}/photos/{photoId} {
      // Участники события могут загружать фото
      allow write: if isEventParticipant(eventId) || isEventOrganizer(eventId);
      allow read: if true;
    }

    // Логотипы сообществ
    match /communities/{communityId}/logo {
      // Загрузка только модератором
      allow write: if isCommunityModeratorOrCreator(communityId);
      allow read: if true;
    }

    // Временные файлы (заливаются перед удалением)
    match /temp/{userId}/{fileName} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Запретить всё остальное
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
